# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/pro-retouching

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Frontend origin(s) for CORS (comma-separated for multiple).
# Only these origins are allowed with credentials (cookies).
# Example production value: https://your-app.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000,https://pro-retouching-k2my.vercel.app

# Cloudinary (image uploads - Phase 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@proretouching.com
ADMIN_PASSWORD=change_me_strong_password
